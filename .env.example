# ==========================================
# StreamFlix Environment Configuration
# Copy this file to .env and configure values
# ==========================================

# Django Core Settings
SECRET_KEY=django-insecure-change-this-in-production-streamflix-secret-key-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# SQL Database Configuration (SQLite by default; configure PostgreSQL for production)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=streamflix_db
# DB_USER=streamflix_user
# DB_PASSWORD=your_secure_db_password
# DB_HOST=localhost
# DB_PORT=5432

# MongoDB Configuration (for Chat Logs & Feedback)
# Defaults to local MongoDB; uses MongoDB Atlas in production
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=streamflix_db

# The Movie Database (TMDB) API
# Get your free API key at https://www.themoviedb.org/settings/api
# If not provided, StreamFlix seamlessly operates in local fallback mode with rich curated movie catalog
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
TMDB_TIMEOUT=5.0

# Security Settings for Production (Set to True in HTTPS production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
